+        <div className="cine-fragments" aria-hidden="true">
+          <svg className="cine-connections" viewBox="0 0 600 500" preserveAspectRatio="none">
+            <defs>
+              <linearGradient id="cine-line-gradient" x1="0" y1="0" x2="1" y2="1">
