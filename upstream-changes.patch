+  .journey-inspector-empty h3 { font-size: 26px; margin-bottom: 10px; }
+  .journey-inspector-empty h3 br { display: none; }
+  .journey-inspector-empty p { margin: 0; max-width: 100%; font-size: 11px; }
+  .journey-inspector-empty .journey-eyebrow { display: none; }
+  .journey-statusbar { padding: 12px 16px; align-items: flex-start; flex-direction: column; gap: 5px; font-size: 9px; }
+  .journey-save-error { padding: 0 16px 18px; }
+}
+@media (prefers-reduced-motion: reduce) { .journey-editor *, .journey-editor *::before, .journey-editor *::after { transition: none !important; animation: none !important; } }
