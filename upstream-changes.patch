+def task_schema(wf: Workflow) -> dict:
+    return {
+        "type": "object",
+        "properties": {
+            "title": {"type": "string", "title": "Task", "minLength": 1, "maxLength": 200},
+            "description": {"type": "string", "title": "Description", "maxLength": 5000},
+            "phase": {"type": "string", "title": "Phase", "enum": wf.phases or ["General"]},
+            "owner_role": {
+                "type": "string",
+                "title": "Owner",
+                "enum": [r.name for r in wf.roles] or ["Unassigned"],
+            },
+            "status": {
+                "type": "string",
+                "title": "Status",
+                "enum": ["not_started", "in_progress", "blocked", "done", "skipped"],
+            },
+            "priority": {"type": "string", "title": "Priority", "enum": ["low", "medium", "high"]},
+            "day_offset": {"type": "integer", "title": "Starts (days after kickoff)", "minimum": 0, "maximum": 3650},
+            "duration_days": {"type": "integer", "title": "Duration (days)", "minimum": 1, "maximum": 3650},
+            "customer_visible": {"type": "boolean", "title": "Customer sees this"},
+            "blocked_reason": {"type": "string", "title": "Why is it blocked?", "maxLength": 2000},
+            "automation_hint": {"type": "string", "title": "Automation idea", "readOnly": True, "maxLength": 2000},
+        },
+        "required": ["title", "owner_role", "phase"],
+    }
+
+
+def task_uischema() -> dict:
+    return {
+        "type": "VerticalLayout",
+        "elements": [
+            {"type": "Control", "scope": "#/properties/title"},
+            {"type": "Control", "scope": "#/properties/description",
+             "options": {"multi": True}},
+            {"type": "HorizontalLayout", "elements": [
+                {"type": "Control", "scope": "#/properties/phase"},
+                {"type": "Control", "scope": "#/properties/owner_role"},
+            ]},
+            {"type": "HorizontalLayout", "elements": [
+                {"type": "Control", "scope": "#/properties/status"},
+                {"type": "Control", "scope": "#/properties/priority"},
+            ]},
+            {"type": "HorizontalLayout", "elements": [
+                {"type": "Control", "scope": "#/properties/day_offset"},
+                {"type": "Control", "scope": "#/properties/duration_days"},
+            ]},
+            {"type": "Control", "scope": "#/properties/customer_visible"},
+            {"type": "Control", "scope": "#/properties/blocked_reason",
+             "rule": {"effect": "SHOW", "condition": {
+                 "scope": "#/properties/status", "schema": {"const": "blocked"}}}},
+            {"type": "Control", "scope": "#/properties/automation_hint"},
+        ],
+    }
diff --git a/examples/workflow-builder-starter/backend/app/store.py b/examples/workflow-builder-starter/backend/app/store.py
new file mode 100644
index 0000000..0b92e17
--- /dev/null
+++ b/examples/workflow-builder-starter/backend/app/store.py
@@ -0,0 +1,62 @@
+from __future__ import annotations
+
+import sqlite3
+from contextlib import contextmanager
+from pathlib import Path
+
+from .models import Workflow
+
+
+class VersionConflict(Exception):
+    pass
+
+
+class WorkflowStore:
+    def __init__(self, database: str):
+        self.database = database
+        Path(database).parent.mkdir(parents=True, exist_ok=True)
+        with self.connect() as connection:
+            connection.execute(
+                "CREATE TABLE IF NOT EXISTS workflows "
+                "(id TEXT PRIMARY KEY, version INTEGER NOT NULL, document TEXT NOT NULL)"
+            )
+
+    @contextmanager
+    def connect(self):
+        connection = sqlite3.connect(self.database, timeout=10)
+        try:
+            connection.execute("PRAGMA journal_mode=WAL")
+            with connection:
+                yield connection
+        finally:
+            connection.close()
+
+    def get_workflow(self, workflow_id: str) -> Workflow | None:
+        with self.connect() as connection:
+            row = connection.execute(
+                "SELECT document FROM workflows WHERE id = ?", (workflow_id,)
+            ).fetchone()
+        return Workflow.model_validate_json(row[0]) if row else None
+
+    def list_workflows(self) -> list[Workflow]:
+        with self.connect() as connection:
+            rows = connection.execute("SELECT document FROM workflows ORDER BY rowid").fetchall()
+        return [Workflow.model_validate_json(row[0]) for row in rows]
+
+    def create_workflow(self, workflow: Workflow) -> Workflow:
+        with self.connect() as connection:
+            connection.execute(
+                "INSERT INTO workflows (id, version, document) VALUES (?, ?, ?)",
+                (workflow.id, workflow.version, workflow.model_dump_json()),
+            )
+        return workflow
+
+    def save_workflow(self, workflow: Workflow, expected_version: int) -> Workflow:
+        with self.connect() as connection:
+            result = connection.execute(
+                "UPDATE workflows SET version = ?, document = ? WHERE id = ? AND version = ?",
+                (workflow.version, workflow.model_dump_json(), workflow.id, expected_version),
+            )
+            if result.rowcount != 1:
+                raise VersionConflict("This workflow changed in another tab. Reload before saving.")
+        return workflow
