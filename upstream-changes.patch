+.cine-orbit-caption > span { display: block; width: 4px; height: 4px; border-radius: 50%; background: #b6cba3; }
+.cine-fallback-orbit { display: none; position: absolute; inset: 22% 29%; aspect-ratio: 1; height: auto; border-radius: 50%; box-shadow: inset 0 0 25px #c1ebc81c, 0 0 55px #9cc5a91c; border: 1px solid #bbd8b34d; transform: rotate(-25deg) scaleY(0.85); }
